          {
            "title": "GAC 2026 WTO chicken TRQ processor list (J&W quota)",
            "url": "https://www.international.gc.ca/trade-commerce/controls-controles/chicken-poulet/wto_processor-2026-omc_transformateurs.aspx?lang=eng"
