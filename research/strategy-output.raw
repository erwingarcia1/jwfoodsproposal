        "agentNeeds": [
          {
            "name": "Partner Scout (B2B prospecting agent)",
            "job": "Builds target lists of gyms, CrossFit boxes, clinics, supplement shops, fight gyms and teams along the GTA 1-4 route corridors (Google Maps, websites, Clay enrichment). Scores fit, drafts personal outreach with a free tasting-tray offer, books tastings and follows up. Runs a CASL check on every message. Lucas approves each sequence.",
            "onScreen": "Team view, AI drafts: outreach email to Birchmount Strength Co. with a CASL check line and Approve / Edit / Skip."
          },
          {
            "name": "Application Checker (onboarding and credit agent)",
            "job": "Reads each application, checks the business is real (website, Google listing, address), maps it to a route day, suggests a tier and starter order, flags existing retail customers (for incrementality), and drafts the welcome email and price list. The owner approves tier and terms. Net-15 only after 4 paid orders.",
            "onScreen": "Customer view: the instant AI pre-check card after Send application. Team view: Applications queue with AI notes and Approve as suggested / Change tier / Decline."
          },
          {
            "name": "Par Level Planner (partner reorder agent)",
            "job": "Each Friday, uses the partner's freezer count (typed or photo), four weeks of sell-through and the season (January rush, summer dip, team season) to draft next week's standing order per partner and suggest par changes. The partner approves by Sunday; nothing ships without approval.",
            "onScreen": "Partner portal (demo): Suggested order for Wednesday table with on hand, sold last week and suggested quantities. Team view: par-change draft for Brimley Barbell Club."
          },
          {
            "name": "Production & Route Planner (shared with the production forecast and route agents)",
            "job": "Rolls approved partner orders into Monday's cook, portion and vacuum-pack sheet and the raw-material order, checks plant load against capacity (alert at 90%), and slots partner drops into GTA 1-4 routes with the dispatcher.",
            "onScreen": "Team view, Production and route impact: +180 pre-set meals, 8 chicken cases, partner stops by route day and a plant-load meter."
          },
          {
            "name": "Label & Claims Checker",
            "job": "Builds 'Fuelled by J&W at [partner]' co-branded labels from J&W's master recipe file (ingredients, allergens, net weight, best-before, plant details) and blocks health or disease claims (for example GLP-1 or diabetes) in partner copy. A person signs off every new label.",
            "onScreen": "Customer view: live label preview in Your name on the label. Team view: a draft with 'great for GLP-1 patients' removed."
          },
          {
            "name": "Partner Receivables agent",
            "job": "Issues net-15 invoices from approved orders, reconciles payments, sends polite reminders at 3 and 7 days overdue, and recommends pausing a standing order at 30 days, which the owner approves.",
            "onScreen": "Team view: Receivables aging buckets, DSO and a reminder draft to Harbour & Hill Nutrition. Partner portal: invoice list."
          },
          {
            "name": "Partner desk chat (shared Butler Concierge, partner mode)",
            "job": "Answers partner questions on minimums, tiers, freezer loans, cut-offs, labels and member codes from the approved price list and agreement, and hands any pricing exception to Lucas.",
            "onScreen": "Chat 'Ask the Butler · Partner desk' with the scripted partner rules."
          }
