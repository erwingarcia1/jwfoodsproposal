            "rules": [
              {
                "match": "point|how many pts|extra point",
                "reply": "Each cut has a point price, about $5 of our shelf price per point. An 11–12 oz AAA ribeye is 5 points, an 8–9 oz Wagyu striploin is 7, a 1 lb bag of ground chicken breast is 2. Extra points are $5. Up to 5 unused points roll to your next box."
              },
              {
                "match": "skip|pause|cancel|change my box",
                "reply": "Skip, swap, pause or cancel online until Sunday 11:59 pm before your route day. No contract, no fee. Try it in My Club (demo)."
              },
              {
                "match": "free|for life|chicken pack",
                "reply": "Every box includes one free item while you're a member: Meal Butler cooked chicken 4 x 4 oz in your flavour, 1 lb Wagyu/Kobe AAA ground, or a wild sockeye fillet."
              },
              {
                "match": "share|quarter|cow|1/8|1/16|eighth|sixteenth|side of beef",
                "reply": "Beef shares come as 1/16 ($325), 1/8 ($625) and 1/4 ($1,200, our current price). The 1/16 and 1/8 are concept prices built from the quarter. Weights are planning estimates until we weigh a test quarter. Reserve with a deposit and pick your cuts on the cut sheet."
              },
              {
                "match": "wild ?fork",
