            "rules": [
              {
                "match": "(cost|budget|how much).*(staff|team|employee|people)|\\$\\s?\\d+(\\.\\d+)?\\s*off",
                "reply": "Here's a rough example. With 100 staff on site 3 days a week and $3 off each meal, about a quarter of people order, which is roughly 56 lunches a week. The company would cover about $168 a week, or around $730 a month, and staff pay about $8.70 for a typical lunch. Try the perk designer on this page to change any number. All figures are estimates."
              },
              {
                "match": "freezer|fridge|storage|space|kitchen",
                "reply": "You need a microwave and some freezer space. Each person's meals arrive in one sealed, named bag. Sites with 75 or more staff on site can borrow a J&W glass-door freezer at no charge when team orders and freezer sales average $250 a week. We restock it on your route day."
              },
              {
                "match": "\\btax|taxable|\\bcra\\b|payroll",
